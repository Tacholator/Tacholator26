{
  "name": "InvoiceSequence",
  "type": "object",
  "properties": {
    "instructorId": {
      "type": "string",
      "description": "Reference to instructor (for per-instructor sequences)"
    },
    "year": {
      "type": "number",
      "description": "Year for this sequence"
    },
    "nextSeq": {
      "type": "number",
      "default": 1,
      "description": "Next sequence number to use"
    }
  },
  "required": [
    "instructorId",
    "year"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.instructorId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.instructorId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.instructorId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.instructorId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}