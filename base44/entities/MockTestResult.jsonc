{
  "name": "MockTestResult",
  "type": "object",
  "properties": {
    "pupilId": {
      "type": "string",
      "description": "Reference to the pupil"
    },
    "instructorId": {
      "type": "string",
      "description": "Reference to the instructor"
    },
    "mockTestId": {
      "type": "string",
      "enum": [
        "mock_1",
        "mock_2",
        "mock_3"
      ],
      "description": "Which mock test"
    },
    "result": {
      "type": "string",
      "enum": [
        "pass",
        "fail"
      ],
      "description": "Test result"
    },
    "instructorComments": {
      "type": "string",
      "description": "Instructor's comments"
    },
    "pupilComments": {
      "type": "string",
      "description": "Pupil's comments"
    },
    "testDate": {
      "type": "string",
      "format": "date",
      "description": "Date of the mock test"
    }
  },
  "required": [
    "pupilId",
    "mockTestId"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.instructorId": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.instructorId": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.instructorId": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.instructorId": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}