{
  "name": "SupportMessage",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string",
      "description": "User ID of the sender"
    },
    "userEmail": {
      "type": "string"
    },
    "userName": {
      "type": "string"
    },
    "userRole": {
      "type": "string",
      "enum": [
        "instructor",
        "learner"
      ]
    },
    "subject": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "resolved"
      ],
      "default": "open"
    },
    "adminReply": {
      "type": "string"
    },
    "repliedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "userId",
    "message",
    "subject"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "data.userId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}