{
  "name": "WhiteboardStep",
  "type": "object",
  "properties": {
    "boardId": {
      "type": "string",
      "description": "Reference to WhiteboardBoard"
    },
    "stepIndex": {
      "type": "number",
      "description": "Order of step"
    },
    "title": {
      "type": "string",
      "description": "Step title"
    },
    "caption": {
      "type": "string",
      "description": "Optional caption text"
    },
    "boardStateRef": {
      "type": "object",
      "description": "Snapshot of board state at this step"
    },
    "voiceNoteUrl": {
      "type": "string",
      "description": "URL to voice note audio"
    },
    "durationSec": {
      "type": "number",
      "description": "Duration in seconds"
    }
  },
  "required": [
    "boardId",
    "stepIndex",
    "title"
  ],
  "rls": {
    "create": {
      "data.boardId": {
        "$in": [
          "{{base44.entities.WhiteboardBoard.list('id', 'ownerInstructorId=')}}"
        ]
      }
    },
    "read": {
      "$or": [
        {
          "data.boardId": {
            "$in": [
              "{{base44.entities.WhiteboardBoard.list('id', 'ownerInstructorId=')}}"
            ]
          }
        },
        {
          "$and": [
            {
              "data.boardId": {
                "$in": [
                  "{{base44.entities.WhiteboardBoard.list('id', 'linkedPupilId=', 'isSharedWithPupil=true')}}"
                ]
              }
            },
            {
              "user_condition": {
                "role": "user"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "data.boardId": {
        "$in": [
          "{{base44.entities.WhiteboardBoard.list('id', 'ownerInstructorId=')}}"
        ]
      }
    },
    "delete": {
      "data.boardId": {
        "$in": [
          "{{base44.entities.WhiteboardBoard.list('id', 'ownerInstructorId=')}}"
        ]
      }
    }
  }
}