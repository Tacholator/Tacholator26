{
  "name": "CommunityComment",
  "type": "object",
  "properties": {
    "postId": {
      "type": "string",
      "description": "Reference to CommunityPost ID"
    },
    "userId": {
      "type": "string",
      "description": "ID of the user who commented"
    },
    "userFullName": {
      "type": "string",
      "description": "Full name of the commenter"
    },
    "userRole": {
      "type": "string",
      "enum": [
        "instructor",
        "learner",
        "admin"
      ]
    },
    "content": {
      "type": "string",
      "description": "Text content of the comment"
    }
  },
  "required": [
    "postId",
    "userId",
    "userFullName",
    "userRole",
    "content"
  ]
}