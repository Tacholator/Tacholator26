{
  "name": "DeletionRequest",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string"
    },
    "userEmail": {
      "type": "string"
    },
    "userName": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "additionalInfo": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "resolved"
      ],
      "default": "pending"
    }
  },
  "required": [
    "userId",
    "userEmail",
    "reason"
  ]
}