{
  "name": "DeletionRequest",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string"
    },
    "userEmail": {
      "type": "string"
    },
    "userName": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "learner",
        "instructor"
      ],
      "default": "learner",
      "description": "Role of the deleted user at the time of deletion"
    },
    "reason": {
      "type": "string"
    },
    "additionalInfo": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "resolved"
      ],
      "default": "pending"
    }
  },
  "required": [
    "userId",
    "userEmail",
    "reason"
  ]
}