{
  "name": "McqAttempt",
  "type": "object",
  "properties": {
    "pupilId": {
      "type": "string",
      "description": "Reference to the pupil"
    },
    "instructorId": {
      "type": "string",
      "description": "Reference to the instructor"
    },
    "topicId": {
      "type": "string",
      "description": "Topic identifier (e.g., 'legal_responsibilities')"
    },
    "mcqPackId": {
      "type": "string",
      "description": "MCQ pack identifier"
    },
    "attemptNumber": {
      "type": "number",
      "description": "Sequential attempt number for this pupil+pack"
    },
    "questionIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Order of questions presented during this attempt"
    },
    "answers": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Array of {questionId, selectedOptionIndex}"
    },
    "score": {
      "type": "number",
      "description": "Number of correct answers"
    },
    "totalQuestions": {
      "type": "number"
    },
    "passMark": {
      "type": "number"
    },
    "passed": {
      "type": "boolean"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "submittedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "pupilId",
    "topicId",
    "mcqPackId",
    "attemptNumber",
    "score",
    "passed"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.instructorId": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.instructorId": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.instructorId": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.instructorId": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}