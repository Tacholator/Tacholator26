{
  "name": "WhiteboardLayerData",
  "type": "object",
  "properties": {
    "boardId": {
      "type": "string",
      "description": "Reference to WhiteboardBoard"
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Canvas objects (shapes, text, etc)"
    },
    "strokes": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Pen/highlighter strokes"
    },
    "texts": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Text elements on canvas"
    },
    "pupilNotes": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Pupil's annotation layer"
    }
  },
  "required": [
    "boardId"
  ],
  "rls": {
    "create": {
      "data.boardId": {
        "$in": [
          "{{base44.entities.WhiteboardBoard.list('id', 'ownerInstructorId=')}}"
        ]
      }
    },
    "read": {
      "$or": [
        {
          "data.boardId": {
            "$in": [
              "{{base44.entities.WhiteboardBoard.list('id', 'ownerInstructorId=')}}"
            ]
          }
        },
        {
          "$and": [
            {
              "data.boardId": {
                "$in": [
                  "{{base44.entities.WhiteboardBoard.list('id', 'linkedPupilId=', 'isSharedWithPupil=true')}}"
                ]
              }
            },
            {
              "user_condition": {
                "role": "user"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "data.boardId": {
        "$in": [
          "{{base44.entities.WhiteboardBoard.list('id', 'ownerInstructorId=')}}"
        ]
      }
    },
    "delete": {
      "data.boardId": {
        "$in": [
          "{{base44.entities.WhiteboardBoard.list('id', 'ownerInstructorId=')}}"
        ]
      }
    }
  }
}