{
  "name": "CommunityLike",
  "type": "object",
  "properties": {
    "postId": {
      "type": "string",
      "description": "Reference to CommunityPost ID"
    },
    "userId": {
      "type": "string",
      "description": "ID of the user who liked the post"
    }
  },
  "required": [
    "postId",
    "userId"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.userId": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.userId": "{{user.id}}"
        }
      ]
    }
  }
}