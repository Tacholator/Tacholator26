{
  "name": "InstructorMcqSettings",
  "type": "object",
  "properties": {
    "instructorId": {
      "type": "string",
      "description": "Reference to the instructor"
    },
    "autoAssignNextTopicOnCompletion": {
      "type": "boolean",
      "default": false,
      "description": "Auto-assign next topic when pupil passes MCQ"
    }
  },
  "required": [
    "instructorId"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.instructorId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.instructorId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.instructorId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.instructorId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}