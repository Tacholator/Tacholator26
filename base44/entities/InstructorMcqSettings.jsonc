{
  "name": "InstructorMcqSettings",
  "type": "object",
  "properties": {
    "instructorId": {
      "type": "string",
      "description": "Reference to the instructor"
    },
    "autoAssignNextTopicOnCompletion": {
      "type": "boolean",
      "default": false,
      "description": "Auto-assign next topic when pupil passes MCQ"
    }
  },
  "required": [
    "instructorId"
  ],
  "rls": {
    "create": {
      "data.instructorId": "{{user.id}}"
    },
    "read": {
      "data.instructorId": "{{user.id}}"
    },
    "update": {
      "data.instructorId": "{{user.id}}"
    },
    "delete": {
      "data.instructorId": "{{user.id}}"
    }
  }
}