{
  "name": "InstructorVideoResource",
  "type": "object",
  "properties": {
    "instructorId": {
      "type": "string",
      "description": "Reference to the instructor user ID who owns this video"
    },
    "instructorEmail": {
      "type": "string",
      "description": "Instructor email for display/fallback matching",
      "rls": {
        "read": {
          "$or": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "topic": {
      "type": "string",
      "description": "Topic chosen by the instructor that this video sits under"
    },
    "title": {
      "type": "string",
      "description": "Video title"
    },
    "videoUrl": {
      "type": "string",
      "description": "Full video URL"
    },
    "videoId": {
      "type": "string",
      "description": "Extracted YouTube video ID (used for thumbnail)"
    },
    "description": {
      "type": "string",
      "description": "Optional short description"
    },
    "visibleToPupils": {
      "type": "boolean",
      "default": false,
      "description": "Whether linked pupils can see this video"
    }
  },
  "required": [
    "instructorId",
    "topic",
    "title",
    "videoUrl"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "data.instructorId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.instructorId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.instructorId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}