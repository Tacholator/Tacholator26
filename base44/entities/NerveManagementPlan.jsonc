{
  "name": "NerveManagementPlan",
  "type": "object",
  "properties": {
    "pupilId": {
      "type": "string",
      "description": "Reference to the pupil"
    },
    "pupilName": {
      "type": "string",
      "description": "Pupil's full name (denormalised for display)"
    },
    "instructorId": {
      "type": "string",
      "description": "Reference to the instructor user ID"
    },
    "calm_plan": {
      "type": "string",
      "description": "Pupil's test-day calm plan (Section 9)"
    },
    "checklist_items": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Checklist items confirmed by pupil before test (Section 11)"
    },
    "nerve_confidence_rating": {
      "type": "number",
      "description": "Confidence rating 1-5 (Section 12)"
    },
    "main_test_worries": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Main test worries selected by pupil (Section 13)"
    },
    "nerve_control_plan": {
      "type": "string",
      "description": "Practical steps pupil will take to manage worries (Section 14)"
    },
    "instructorRecommendations": {
      "type": "string",
      "description": "Instructor's recommendations for managing nerves"
    }
  },
  "required": [
    "pupilId"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.instructorId": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.instructorId": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.instructorId": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.instructorId": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}