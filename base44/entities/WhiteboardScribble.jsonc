{
  "name": "WhiteboardScribble",
  "type": "object",
  "properties": {
    "pupilId": {
      "type": "string",
      "description": "Reference to the pupil"
    },
    "pupilUserId": {
      "type": "string",
      "description": "The linked user ID of the pupil (for RLS - allows learner to read their own notes)"
    },
    "instructorId": {
      "type": "string",
      "description": "Reference to the instructor who created the scribble"
    },
    "topic": {
      "type": "string",
      "description": "Topic or title for this class note"
    },
    "scribbleData": {
      "type": "object",
      "description": "JSON representation of the whiteboard strokes and objects"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When the scribble was created/last saved"
    }
  },
  "required": [
    "pupilId",
    "instructorId",
    "scribbleData",
    "timestamp"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.pupilId": "{{user.data.pupil.id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.pupilUserId": "{{user.id}}"
        },
        {
          "data.instructorId": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.pupilUserId": "{{user.id}}"
        },
        {
          "data.instructorId": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.pupilUserId": "{{user.id}}"
        },
        {
          "data.instructorId": "{{user.id}}"
        }
      ]
    }
  }
}