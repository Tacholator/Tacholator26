{
  "name": "Conversation",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "instructor_pupil"
      ],
      "default": "instructor_pupil",
      "description": "Type of conversation"
    },
    "instructorId": {
      "type": "string",
      "description": "Reference to instructor user ID"
    },
    "pupilId": {
      "type": "string",
      "description": "Reference to pupil user ID"
    },
    "isActive": {
      "type": "boolean",
      "default": false,
      "description": "Becomes true when at least 1 message is sent or thread opened"
    },
    "lastMessageAt": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of last message"
    },
    "lastMessagePreview": {
      "type": "string",
      "description": "Preview of last message"
    }
  },
  "required": [
    "type",
    "instructorId",
    "pupilId"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.instructorId": "{{user.id}}"
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.pupilId": "{{user.data.pupil.id}}"
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.instructorId": "{{user.id}}"
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.pupilId": "{{user.data.pupil.id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.instructorId": "{{user.id}}"
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.pupilId": "{{user.data.pupil.id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.instructorId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}