{
  "name": "DiaryEntry",
  "type": "object",
  "properties": {
    "lessonId": {
      "type": "string"
    },
    "instructorId": {
      "type": "string"
    },
    "pupilId": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "objective": {
      "type": "string"
    },
    "mainTopic": {
      "type": "string",
      "description": "Main topic covered in the lesson"
    },
    "whatWentWell": {
      "type": "string"
    },
    "areasToImprove": {
      "type": "string"
    },
    "instructorComments": {
      "type": "string"
    },
    "homeworkSuggestions": {
      "type": "string"
    },
    "aiSummary": {
      "type": "string"
    },
    "aiSummaryGeneratedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "pupilId",
    "date",
    "mainTopic"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.instructorId": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.instructorId": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.instructorId": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.instructorId": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}