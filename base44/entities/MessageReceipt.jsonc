{
  "name": "MessageReceipt",
  "type": "object",
  "properties": {
    "messageId": {
      "type": "string",
      "description": "Reference to message ID"
    },
    "userId": {
      "type": "string",
      "description": "Recipient of this receipt"
    },
    "status": {
      "type": "string",
      "enum": [
        "delivered",
        "read"
      ],
      "description": "Receipt status"
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "description": "When status occurred"
    }
  },
  "required": [
    "messageId",
    "userId",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}