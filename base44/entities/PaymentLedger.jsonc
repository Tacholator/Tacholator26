{
  "name": "PaymentLedger",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string",
      "description": "Reference to user (pupil) ID"
    },
    "bookingId": {
      "type": "string",
      "description": "Reference to lesson booking ID"
    },
    "type": {
      "type": "string",
      "enum": [
        "charge",
        "payment",
        "refund",
        "adjustment"
      ],
      "description": "Type of ledger entry"
    },
    "reason": {
      "type": "string",
      "enum": [
        "lesson_confirmed_charge",
        "late_cancellation_penalty",
        "balance_top_up",
        "manual_adjustment",
        "refund_issued"
      ],
      "description": "Reason for the entry"
    },
    "amountGbp": {
      "type": "number",
      "description": "Amount in GBP"
    },
    "hours": {
      "type": "number",
      "description": "Number of hours (for tracking)"
    },
    "createdByRole": {
      "type": "string",
      "enum": [
        "system",
        "instructor",
        "admin"
      ],
      "description": "Who created this entry"
    },
    "note": {
      "type": "string",
      "description": "Additional notes"
    }
  },
  "required": [
    "userId",
    "type",
    "reason",
    "createdByRole"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.createdByRole": "instructor",
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "service_role"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.userId": "{{user.data.pupil.id}}"
        },
        {
          "data.userId": {
            "$in": [
              "{{user.id}}",
              "{{user.data.pupil.id}}",
              "{{user.data.pupil.linkedUserId}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}