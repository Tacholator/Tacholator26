{
  "name": "TypingState",
  "type": "object",
  "properties": {
    "conversationId": {
      "type": "string",
      "description": "Reference to conversation ID"
    },
    "userId": {
      "type": "string",
      "description": "Reference to user ID"
    },
    "isTyping": {
      "type": "boolean",
      "default": false,
      "description": "Whether user is currently typing"
    },
    "lastPingAt": {
      "type": "string",
      "format": "date-time",
      "description": "Last typing ping timestamp"
    }
  },
  "required": [
    "conversationId",
    "userId"
  ],
  "rls": {
    "create": {
      "data.userId": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "user.condition": {
            "role": "admin"
          }
        },
        {
          "data.userId": "{{user.id}}"
        },
        {
          "data.conversationId": "{{user.data.pupil.id}}_{{user.id}}"
        }
      ]
    },
    "update": {
      "data.userId": "{{user.id}}"
    },
    "delete": {
      "data.userId": "{{user.id}}"
    }
  }
}